{
  "Name": "Stream Dock foobar2000",
  "Description": "Control foobar2000 through a local foo_streamdock_control component.",
  "Author": "local",
  "Version": "0.3.0",
  "CodePath": "plugin.html",
  "Icon": "icons/plugin",
  "Category": "Foobar2000-Control",
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Actions": [
    {
      "UUID": "local.streamdock.foobar2000.playpause",
      "Name": "Play/Pause",
      "Tooltip": "Toggle foobar2000 playback.",
      "Controllers": ["Keypad"],
      "Icon": "icons/playpause",
      "States": [{ "Title": "", "Image": "icons/playpause" }],
      "PropertyInspectorPath": "property-inspector.html"
    },
    {
      "UUID": "local.streamdock.foobar2000.stop",
      "Name": "Stop",
      "Tooltip": "Stop foobar2000 playback.",
      "Controllers": ["Keypad"],
      "Icon": "icons/stop",
      "States": [{ "Title": "", "Image": "icons/stop" }],
      "PropertyInspectorPath": "property-inspector.html"
    },
    {
      "UUID": "local.streamdock.foobar2000.previous",
      "Name": "Previous",
      "Tooltip": "Go to the previous foobar2000 track.",
      "Controllers": ["Keypad"],
      "Icon": "icons/previous",
      "States": [{ "Title": "", "Image": "icons/previous" }],
      "PropertyInspectorPath": "property-inspector.html"
    },
    {
      "UUID": "local.streamdock.foobar2000.next",
      "Name": "Next",
      "Tooltip": "Go to the next foobar2000 track.",
      "Controllers": ["Keypad"],
      "Icon": "icons/next",
      "States": [{ "Title": "", "Image": "icons/next" }],
      "PropertyInspectorPath": "property-inspector.html"
    },
    {
      "UUID": "local.streamdock.foobar2000.volume",
      "Name": "Volume",
      "Tooltip": "Adjust foobar2000 volume with a knob and press to mute/unmute.",
      "Controllers": ["Knob"],
      "Icon": "icons/volume",
      "States": [{ "Title": "", "Image": "icons/volume" }],
      "PropertyInspectorPath": "property-inspector.html"
    },
    {
      "UUID": "local.streamdock.foobar2000.trackknob",
      "Name": "Track Knob",
      "Tooltip": "Go to the next or previous foobar2000 track with a knob and press to play/pause.",
      "Controllers": ["Knob"],
      "Icon": "icons/trackknob",
      "States": [{ "Title": "", "Image": "icons/trackknob" }],
      "PropertyInspectorPath": "property-inspector.html"
    },
    {
      "UUID": "local.streamdock.foobar2000.mute",
      "Name": "Mute",
      "Tooltip": "Toggle foobar2000 mute.",
      "Controllers": ["Keypad"],
      "Icon": "icons/mute",
      "States": [{ "Title": "", "Image": "icons/mute" }],
      "PropertyInspectorPath": "property-inspector.html"
    },
    {
      "UUID": "local.streamdock.foobar2000.nowplaying",
      "Name": "Now Playing",
      "Tooltip": "Show current foobar2000 track.",
      "Controllers": ["Keypad"],
      "Icon": "icons/nowplaying",
      "States": [{ "Title": "Now", "Image": "icons/nowplaying" }],
      "PropertyInspectorPath": "property-inspector.html"
    },
    {
      "UUID": "local.streamdock.foobar2000.seek",
      "Name": "Seek",
      "Tooltip": "Seek foobar2000 playback with a knob.",
      "Controllers": ["Knob"],
      "Icon": "icons/seek",
      "States": [{ "Title": "", "Image": "icons/seek" }],
      "PropertyInspectorPath": "property-inspector.html"
    },
    {
      "UUID": "local.streamdock.foobar2000.playbackorder",
      "Name": "Playback Order",
      "Tooltip": "Cycle foobar2000 playback order.",
      "Controllers": ["Keypad"],
      "Icon": "icons/playbackorder",
      "States": [{ "Title": "Order", "Image": "icons/playbackorder" }],
      "PropertyInspectorPath": "property-inspector.html"
    },
    {
      "UUID": "local.streamdock.foobar2000.playlist",
      "Name": "Playlist",
      "Tooltip": "Switch foobar2000 playlist.",
      "Controllers": ["Keypad", "Knob"],
      "Icon": "icons/playlist",
      "States": [{ "Title": "", "Image": "icons/playlist" }],
      "PropertyInspectorPath": "property-inspector.html"
    },
    {
      "UUID": "local.streamdock.foobar2000.rating",
      "Name": "Rating",
      "Tooltip": "Set rating for the current foobar2000 track.",
      "Controllers": ["Keypad", "Knob"],
      "Icon": "icons/rating",
      "States": [{ "Title": "Rate", "Image": "icons/rating" }],
      "PropertyInspectorPath": "property-inspector.html"
    },
    {
      "UUID": "local.streamdock.foobar2000.diagnostics",
      "Name": "Diagnostics",
      "Tooltip": "Show foobar2000 Stream Dock connection diagnostics.",
      "Controllers": ["Keypad"],
      "Icon": "icons/diagnostics",
      "States": [{ "Title": "Diag", "Image": "icons/diagnostics" }],
      "PropertyInspectorPath": "property-inspector.html"
    }
  ]
}
